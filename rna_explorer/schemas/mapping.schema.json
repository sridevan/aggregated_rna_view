{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "ChainResidueMapping", "type": "object",
 "required": ["pdb_id", "entity_id", "label_asym_id", "auth_asym_id", "rfam_acc", "sequence_key", "mapped_region", "residues", "consensus_columns", "provenance"],
 "properties": {
  "pdb_id": {"type": "string", "pattern": "^[0-9][a-z0-9]{3}$"}, "entity_id": {"type": "integer"}, "label_asym_id": {"type": "string"}, "auth_asym_id": {"type": "string"},
  "rfam_acc": {"type": "string", "pattern": "^RF[0-9]{5}$"}, "sequence_key": {"type": "string"},
  "mapped_region": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}},
  "alignment": {"type": ["object", "null"]}, "summary": {"type": "object"},
  "residues": {"type": "array", "items": {"type": "object",
     "required": ["polymer_seq_position", "author_residue_number", "author_insertion_code", "residue_name", "nucleotide_parent", "is_modified", "alignment_state", "rfam_consensus_pos", "insertion_anchor", "insertion_offset", "posterior_prob_char", "posterior_prob", "has_coordinates"],
     "properties": {"polymer_seq_position": {"type": "integer", "minimum": 1}, "author_residue_number": {"type": ["integer", "string", "null"]}, "author_insertion_code": {"type": "string"},
                    "residue_name": {"type": "string"}, "nucleotide_parent": {"type": "string", "minLength": 1, "maxLength": 1}, "is_modified": {"type": "boolean"},
                    "alignment_state": {"enum": ["match", "insert", "local_end", "not_submitted_flank"]}, "rfam_consensus_pos": {"type": ["integer", "null"], "minimum": 1},
                    "insertion_anchor": {"type": ["integer", "null"], "minimum": 0}, "insertion_offset": {"type": ["integer", "null"], "minimum": 1},
                    "posterior_prob_char": {"type": "string", "maxLength": 1}, "posterior_prob": {"type": ["number", "null"]}, "has_coordinates": {"type": "boolean"}},
     "allOf": [{"if": {"properties": {"alignment_state": {"const": "match"}}}, "then": {"properties": {"rfam_consensus_pos": {"type": "integer"}, "insertion_anchor": {"type": "null"}}}},
               {"if": {"properties": {"alignment_state": {"enum": ["insert", "local_end"]}}}, "then": {"properties": {"rfam_consensus_pos": {"type": "null"}, "insertion_anchor": {"type": "integer"}, "insertion_offset": {"type": "integer"}}}}]}},
  "consensus_columns": {"type": "array", "items": {"type": "object", "required": ["rfam_consensus_pos", "state", "polymer_seq_position"],
     "properties": {"rfam_consensus_pos": {"type": "integer", "minimum": 1}, "state": {"enum": ["match", "deletion", "uncovered"]}, "polymer_seq_position": {"type": ["integer", "null"]}}}},
  "provenance": {"type": "object", "required": ["rfam_acc", "rfam_release", "cm_checksum", "cm_clen", "infernal_version", "cmalign_options", "generated"]}}}
